# Plantilla de UNA cuenta para el modo multi-cuenta.
# Copia este archivo a accounts/cuenta01.env, cuenta02.env, ... y edítalo.
# El nombre del archivo (cuenta01) es la etiqueta que verás en Telegram.
# NO subas los archivos reales a git (están en .gitignore); solo EXAMPLE.env.

# --- MetaTrader 5 (cada cuenta su terminal portable) ---
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password
MT5_SERVER=Broker-Demo
# Ruta al terminal64.exe de ESTE terminal (instalación portable por cuenta):
MT5_PATH=C:\MT5\cuenta01\terminal64.exe

# --- Telegram (compartido entre todas las cuentas: solo envío) ---
TG_BOT_TOKEN=123456:ABC-tu_token
TG_CHAT_ID=tu_chat_id

# --- Session Breaker ---
SB_SYMBOLS=EURUSD,GBPUSD,AUDUSD,USDCHF,USDCAD,NZDUSD
SB_SESSIONS=0-7:8-12,9-13:13-17
SB_LOT=0.01
SB_SL_MULT=1.0
SB_TP_MULT=2.0
SB_DAILY_MAX_LOSS=10
SB_BUFFER_PIPS=1.0

# ⚠️ Operar en cuenta REAL automático. En DEMO el bot opera solo (esto se ignora).
# En REAL, solo abre si pones SB_ALLOW_REAL=true (opt-in deliberado). Recuerda:
# sin rebate > spread, en real el trading sangra despacio. Usa microlotes (0.01).
SB_ALLOW_REAL=false

# Session Breaker — configuración de UNA cuenta (modo con Telegram interactivo).
# Copia este archivo a .env y edítalo. NO subas el .env real a git.

# --- MetaTrader 5 ---
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password
MT5_SERVER=Broker-Demo
MT5_PATH=

# --- Telegram ---
TG_BOT_TOKEN=123456:ABC-tu_token
TG_CHAT_ID=tu_chat_id

# --- Session Breaker ---
SB_SYMBOLS=EURUSD,GBPUSD,AUDUSD,USDCHF,USDCAD,NZDUSD
# "rango:trade" en HORA DEL SERVIDOR MT5 (Londres y NY). Calíbralo por bróker.
SB_SESSIONS=0-7:8-12,9-13:13-17
SB_LOT=0.01
SB_SL_MULT=1.0
SB_TP_MULT=2.0
SB_DAILY_MAX_LOSS=10
SB_BUFFER_PIPS=1.0

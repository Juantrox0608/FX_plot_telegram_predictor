# Bot de pares · configuración del cliente. Guardar como C:/Cuanti/cliente_01/secrets/cliente.env
# Nunca subir este archivo con datos reales ni pegarlo en un chat.

# ---- Lo llena el cliente ----
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
TG_BOT_TOKEN=
TG_CHAT_ID=
# false = solo cuenta demo. true = también opera en cuenta real (decisión del cliente).
PAIRS_ALLOW_REAL=false

# ---- No tocar ----
INSTANCE_ID=cliente_01
MT5_PATH=C:/Cuanti/cliente_01/terminal/terminal64.exe
PAIRS_DATA_DIR=C:/Cuanti/cliente_01/runtime
SYMBOL_SUFFIX=.m
PAIRS_MAGIC_BASE=21001000
# Sin esta línea el bot deja de abrir operaciones al mes (licencia por defecto). 120 meses = 10 años.
DEMO_DURATION_MONTHS=120

# Estrategia validada: D1, 6 pares, lookback 60, entrada 1,5, salida 0,3, stop 4,5, correlación 0,7.
# Por defecto: perfil conservador (0,01 lote por US$1.000) y freno diario de 5 %.
PAIRS_TIMEFRAME=D1
PAIRS_LIST=EURUSD-GBPUSD,EURUSD-AUDUSD,EURUSD-NZDUSD,GBPUSD-AUDUSD,GBPUSD-NZDUSD,USDCHF-USDCAD
PAIRS_LOOKBACK=60
PAIRS_ENTRY_Z=1.5
PAIRS_EXIT_Z=0.3
PAIRS_STOP_Z=4.5
PAIRS_MIN_CORR=0.7

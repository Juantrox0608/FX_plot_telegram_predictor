# PLANTILLA PUBLICA: nunca completar ni subir este archivo con datos reales.
# Copiar FUERA del repositorio a C:/Cuanti/cliente_01/secrets/cliente.env
# ENV_FILE se define en el lanzador, no aquí. Una copia del bot y terminal por cliente.
INSTANCE_ID=cliente_01
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:/Cuanti/cliente_01/terminal/terminal64.exe
PAIRS_DATA_DIR=C:/Cuanti/cliente_01/runtime
TG_BOT_TOKEN=
TG_CHAT_ID=
MODE=demo
SYMBOL_SUFFIX=.m
PAIRS_MAGIC_BASE=21001000
PAIRS_ALLOW_REAL=false
SIGNALS_ONLY=false
PAIRS_MAX_TICK_AGE=120
PAIRS_RISK_PROFILE=conservador
DAILY_MAX_LOSS_PERCENT=5
RISK_PERCENT=1
DEMO_DURATION_MONTHS=12
DEMO_DURATION_DAYS=0
DEMO_LICENSE_FILE=C:/Cuanti/cliente_01/runtime/demo_license.json
PAIRS_TIMEFRAME=D1
PAIRS_LIST=EURUSD-GBPUSD,EURUSD-AUDUSD,EURUSD-NZDUSD,GBPUSD-AUDUSD,GBPUSD-NZDUSD,USDCHF-USDCAD
PAIRS_LOOKBACK=60
PAIRS_ENTRY_Z=1.5
PAIRS_STOP_Z=4.5
PAIRS_MIN_CORR=0.7
PAIRS_EXIT_Z=0.3
PAIRS_SIZE_BY_Z=false

# auto verifica avance de ticks y calibra cada ciclo; 2 o 3 requieren verificación.
BROKER_UTC_OFFSET=auto
# JSON público por símbolo/fecha para festivos o sesiones especiales verificadas.
BROKER_SESSIONS_FILE=

# Bot MULTI-PAR / PAIRS — configuración. Copia a .env y edita. NO subas el .env real.

# --- MetaTrader 5 ---
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password
MT5_SERVER=Broker-Demo
MT5_PATH=

# --- Telegram ---
TG_BOT_TOKEN=123456:ABC-tu_token
TG_CHAT_ID=tu_chat_id

# --- Riesgo / kill-switch ---
RISK_PERCENT=1
DAILY_MAX_LOSS_PERCENT=20
MODE=demo

# --- Pairs (arbitraje estadístico, D1) ---
PAIR_A=EURUSD
PAIR_B=GBPUSD
PAIRS_LOOKBACK=20
PAIRS_ENTRY_Z=2.0
PAIRS_STOP_Z=3.5
PAIRS_MIN_CORR=0.6
PAIRS_CAP_PER_UNIT=200

# --- Demo (solo si empaquetas versión de prueba; producción no lo necesita) ---
DEMO_DURATION_MONTHS=1
DEMO_DURATION_DAYS=0

# Bot MULTI-PAR / PAIRS — configuración. Copia a .env y edita. NO subas el .env real.

# --- MetaTrader 5 ---
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password
MT5_SERVER=Broker-Demo
MT5_PATH=

# --- Telegram ---
TG_BOT_TOKEN=123456:ABC-tu_token
TG_CHAT_ID=tu_chat_id

# --- Riesgo / kill-switch ---
RISK_PERCENT=1
DAILY_MAX_LOSS_PERCENT=20
MODE=demo

# --- Multi-par (arbitraje estadístico) ---
# Timeframe: D1 (probado, 3 pares) o H4 (más activo, validado con EUR/GBP + CHF/CAD)
PAIRS_TIMEFRAME=H4
# Lista de pares "A-B,A-B". H4 validado: EUR/GBP + CHF/CAD. D1: +AUDUSD-NZDUSD
PAIRS_LIST=EURUSD-GBPUSD,USDCHF-USDCAD
PAIRS_LOOKBACK=40
PAIRS_ENTRY_Z=2.0
PAIRS_STOP_Z=3.5
PAIRS_MIN_CORR=0.6
PAIRS_CAP_PER_UNIT=200
# ⚠️ En cuenta REAL el bot NO abre solo salvo que pongas esto en true (opt-in deliberado)
PAIRS_ALLOW_REAL=false
# 📢 MODO SEÑALES: postea la señal al chat/canal (TG_CHAT_ID) y NO opera.
# Para un canal donde la gente decide. Más pares / entry_z menor = más señales.
SIGNALS_ONLY=false

# --- Demo (solo si empaquetas versión de prueba; producción no lo necesita) ---
DEMO_DURATION_MONTHS=1
DEMO_DURATION_DAYS=0

# === FX Bot V2 — plantilla de variables de entorno ===
# Copia este archivo a ".env" y rellena tus valores reales.
# NUNCA subas el .env al repositorio (está en .gitignore).

# --- MetaTrader 5 (cuenta DEMO para empezar) ---
MT5_LOGIN=00000000
MT5_PASSWORD=tu_password_demo
MT5_SERVER=NombreBroker-Demo
# Ruta al terminal MT5 (opcional; si MT5 ya está instalado normalmente se detecta solo)
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Telegram ---
# Token que te da @BotFather
TG_BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz
# Tu chat ID (usa @userinfobot para conocerlo). Solo este chat puede controlar el bot.
TG_CHAT_ID=000000000

# --- Trading ---
SYMBOL=EURUSD
# Temporalidad: M1 para pruebas, M15/H1 para producción
TIMEFRAME=M1
# Riesgo por operación en % del balance (1 a 5)
RISK_PERCENT=1.0
# Límite de pérdida diaria en % del balance (kill-switch). Modificable con /dailyrisk
DAILY_MAX_LOSS_PERCENT=5.0
# Modo de arranque: demo | real  (SIEMPRE arranca en demo)
MODE=demo

# --- Datos ---
# Años de histórico a descargar para entrenar la IA
HISTORY_YEARS=4
